# SupportFlow backend — copy to backend/.env and fill in

# development | production
ENVIRONMENT=development

# MUST be a long random string (>= 32 chars) before any real deploy
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRY_HOURS=24

# Flask debug (never enable in production)
FLASK_DEBUG=0

# Local Vite (dev) or your public tunnel URL when sharing from this laptop
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# Bind 0.0.0.0 so ngrok/cloudflare can reach Flask
HOST=127.0.0.1
PORT=5000
ALLOW_TUNNEL_ORIGINS=true

OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=mistral
PRODUCT_NAME=SupportFlow
FREE_PREVIEW_CHAT_LIMIT=100


# Public TechFlow demo on the landing page (disable in production)
ALLOW_PUBLIC_DEMO=true

# When true, widget Origins must be on the business allowlist (forced true in production)
WIDGET_STRICT_ORIGINS=false

# Rate limits (requests per minute per IP / key)
RATE_LIMIT_AUTH=20
RATE_LIMIT_CHAT=40
RATE_LIMIT_CHAT_WIDGET=60
RATE_LIMIT_DEMO=20

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Monthly plans (CAD) — Basic / Professional / Premium
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PROFESSIONAL=price_...
STRIPE_PRICE_ID_PREMIUM=price_...
# Local webhook: stripe listen --forward-to localhost:5000/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Only for local testing WITHOUT a webhook secret — never in production
ALLOW_INSECURE_WEBHOOK=false
